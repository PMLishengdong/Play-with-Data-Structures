<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="MessageBubble" parent="android:Widget.TextView">
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/message_bubble</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="UserMessageBubble" parent="MessageBubble">
        <item name="android:background">@drawable/message_bubble_user</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="AIMessageBubble" parent="MessageBubble">
        <item name="android:background">@drawable/message_bubble_ai</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
